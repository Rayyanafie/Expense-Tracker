        "query": "INSERT INTO transactions (\n  telegram_id,\n  date,\n  time,\n  total_amount,\n  merchant,\n  category,\n  line_items\n)\nVALUES (\n  {{ $('Sub-Tracker Entry').item.json.message.from.id }},\n  '{{ $('Parse Gemini JSON').item.json.parsed_text.date }}',\n  {{ $('Parse Gemini JSON').item.json.parsed_text.time ? `'${$('Parse Gemini JSON').item.json.parsed_text.time}'` : 'NULL' }},\n  {{ $('Parse Gemini JSON').item.json.parsed_text.total_amount }},\n  '{{ $('Parse Gemini JSON').item.json.parsed_text.merchant.replace(/'/g, \"''\") }}',\n  '{{ $('Parse Gemini JSON').item.json.parsed_text.category }}',\n  '{{ JSON.stringify($('Parse Gemini JSON').item.json.parsed_text.line_items).replace(/'/g, \"''\") }}'::jsonb\n)\nRETURNING id, total_amount, category, merchant, date;",
